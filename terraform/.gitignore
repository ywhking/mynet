# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Locally generated SSH keys
keys/

# Per-tenant terraform working directories created by the portal backend
# (Settings.tenants_dir). Each holds a copy of the module plus one tenant's
# generated keys/ and state, so it must never be committed.
.tenants/

# Terraform plan output
*.plan
plan.out

# Sensitive files
terraform.tfvars
*.tfvars
!terraform.tfvars.example
accesskey.txt

# Locally generated Ansible inventory (auto-generated by generate_inventory.sh)
ansible/inventory/hosts.yml

# Ansible
*.retry
/tmp/ansible-*

# Windows Zone Identifier junk files
*.Zone.Identifier

# Local Claude Code config
.claude/
