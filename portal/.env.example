# ============================================================================
# portal 栈的环境文件 —— 复制成 portal/.env 后填写。
#
#   cp portal/.env.example portal/.env
#   # 编辑 portal/.env
#   cd portal && ./deploy.sh
#
# 注意：这是 **docker compose 栈** 的环境，不是 portal/backend/.env.example。
# 后者是本地开发（`cd portal/backend && uvicorn app.main:app`）用的后端环境。
# 容器部署时后端不读 backend/.env —— 所有配置都由这个文件经 compose 的
# `env_file:` 注入（pydantic-settings 大小写不敏感地映射到 Settings 字段）。
# portal/.env 已被 gitignore。
# ============================================================================

# ---------------------------------------------------------------------------
# 必填 —— 缺失或仍是占位值，两个进程都会在启动时直接拒绝运行
# ---------------------------------------------------------------------------

# 后端签发 JWT 的密钥。不设或仍是内置默认值会拒绝启动（防止用公开密钥伪造令牌）。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Let's Encrypt 通知邮箱。**必须是真邮箱**：playbook 会拒绝
# @example/@test/@invalid.(com|org|net|edu) 这类占位地址。
NETBIRD_LETSENCRYPT_EMAIL=

# ---------------------------------------------------------------------------
# 必填 —— 平台方阿里云凭据。所有租户的基础设施都建在这个账号下。
# 这两个没有启动校验，留空不会报错，只会让每次 terraform apply 无凭据地失败。
# ---------------------------------------------------------------------------
ALICLOUD_ACCESS_KEY=
ALICLOUD_SECRET_KEY=

# 已注册并接入阿里云云解析 DNS 的主域名（租户子域名挂在其下：
# <实例>.<子域名>.<PLATFORM_DOMAIN>）。留成 example.com 不会被拦截，
# 但要到租户 apply 时才会以 DNS 失败暴露出来。
PLATFORM_DOMAIN=

# ---------------------------------------------------------------------------
# 必填 —— NetBird 离线制品在**容器内**的路径。
# playbook 的默认值指向作者工作站的绝对路径，写错会在最后两个 play 才失败，
# 而那时云资源已经建好了。把文件放进 portal/artifacts/（该目录被 gitignore，
# 并以只读方式挂到 /artifacts）。
# ---------------------------------------------------------------------------
NETBIRD_PACKAGE=/artifacts/netbird-install-20260816.tar.gz
NETBIRD_BINARY=/artifacts/netbird

# ---------------------------------------------------------------------------
# 可选 —— 地域与机型
# ---------------------------------------------------------------------------
ALICLOUD_REGION=cn-wulanchabu
VSWITCH_ZONE=cn-wulanchabu-a
# 刻意做成服务端配置而非客户端参数：实例规格记在平台账号上，
# 让租户自选等于把开销上限交给租户。
ECS_INSTANCE_TYPE=ecs.t6-c1m2.large

# ---------------------------------------------------------------------------
# 可选 —— 配额护栏（自助注册 + 平台统一计费下的关键约束）
# ---------------------------------------------------------------------------
QUOTA_MAX_VMS=10
QUOTA_MAX_RUNNING_DEPLOYMENTS=1

# ---------------------------------------------------------------------------
# 可选 —— 中国区加速（apt 源与 docker 镜像）；留空则用官方源
# ---------------------------------------------------------------------------
DOCKER_REPO_BASE=
DOCKER_MIRRORS=

# ---------------------------------------------------------------------------
# 可选 —— 构建期镜像源（离线/国内构建加速）；留空则用官方 registry
# ---------------------------------------------------------------------------
NPM_REGISTRY=
PIP_INDEX_URL=

# ---------------------------------------------------------------------------
# 可选 —— 仅供调试的本地回环端口。公网入口是 `deploy/` 那套 Caddy，
# 它通过 mynet 网络把域名反代到 portal-api:8000。
# ---------------------------------------------------------------------------
API_DEBUG_BIND=127.0.0.1
API_DEBUG_PORT=18000

# 不要设置 ALLOW_INSECURE_DEV_DEFAULTS —— 那是给本地开发绕过启动校验用的。
# ALLOW_INSECURE_DEV_DEFAULTS=true
