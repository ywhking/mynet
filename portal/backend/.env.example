# ============================================================
# portal/backend/.env — BOTH the API server and the worker read this file.
#
#   cp .env.example .env  &&  edit the values below
#
# Every process that imports `app.config` (the uvicorn API and the worker) picks
# this up automatically. Do NOT rely on `export` in one terminal: the worker is a
# separate process and would silently run without the Alibaba credentials, making
# every `terraform apply` run keyless.
# ============================================================

# --- Required ---------------------------------------------------------------

# Signs portal session tokens. Anyone who knows it can forge a token for any
# email, i.e. reach every tenant's deployment. The built-in default
# ("dev-secret-change-me") is refused at startup; generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Alibaba Cloud credentials used by `terraform apply` (the platform's account).
ALICLOUD_ACCESS_KEY=
ALICLOUD_SECRET_KEY=

# Let's Encrypt / ACME notification address for the NetBird server on the
# bastion. Required: the playbook asserts it is present and is not an
# @example/@test/@invalid placeholder.
NETBIRD_LETSENCRYPT_EMAIL=

# --- Deployment target ------------------------------------------------------

# The registered domain the platform's DNS zone lives in. A tenant's zone is
# "<subdomain>.<PLATFORM_DOMAIN>", and each public instance gets an A record in
# it, so an instance's FQDN is
# "<instance domain_name>.<subdomain>.<PLATFORM_DOMAIN>"
# (e.g. bastion.acme.mynet.vip).
PLATFORM_DOMAIN=yourplatform.example.com
ALICLOUD_REGION=cn-wulanchabu
VSWITCH_ZONE=cn-wulanchabu-a

# ECS size for every tenant instance. Not client-configurable: it is billed to
# the account above.
ECS_INSTANCE_TYPE=ecs.t6-c1m2.large

# --- Paths ------------------------------------------------------------------
# Relative to the documented launch cwd (`cd portal/backend`).

# Source terraform module (never written to; see TENANTS_DIR).
TERRAFORM_DIR=../../terraform
# Per-tenant working directories: a copy of the module plus one tenant's keys and
# state. Gitignored. Keeping these separate is what stops tenants from sharing
# SSH key pairs and terraform state.
TENANTS_DIR=../../terraform/.tenants
ANSIBLE_DIR=../../terraform/ansible
INVENTORY_SCRIPT=inventory/generate_inventory.sh

# --- Ansible playbook inputs -------------------------------------------------
# Leave empty to keep each playbook's own default. The referenced defaults are
# absolute paths on the author's workstation, so a deploy from another machine
# must set these.

# setup-netbird.yml: local offline server package (netbird-install-<date>.tar.gz)
NETBIRD_PACKAGE=
# setup-netbird-agent.yml: locally built netbird client binary
NETBIRD_BINARY=
# setup-docker.yml: apt repo + registry mirror. download.docker.com is
# intermittently RST from mainland China.
DOCKER_REPO_BASE=
DOCKER_MIRRORS=

# --- Quotas / worker --------------------------------------------------------

WORKER_MAX_CONCURRENCY=1
QUOTA_MAX_VMS=10
QUOTA_MAX_RUNNING_DEPLOYMENTS=1
DATABASE_URL=sqlite:///./portal.db

# --- Development only -------------------------------------------------------
# Re-enables the publicly known default JWT secret. NEVER set this in a
# deployment that serves real tenants.
#ALLOW_INSECURE_DEV_DEFAULTS=true
